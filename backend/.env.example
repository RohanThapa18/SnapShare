NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=

# Redis (used by BullMQ for AI processing + event expiry jobs in later phases)
REDIS_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 64-character hex string (32 bytes) used to reversibly encrypt event
# passcodes so organizers can view them again later (separate from the
# bcrypt hash used to verify joins, which can never be reversed).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSCODE_ENCRYPTION_KEY=

# Cloudinary (Phase 5)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (Phase 8)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Python AI microservice (Phase 7)
AI_SERVICE_URL=
AI_SERVICE_SHARED_SECRET=
FACE_MATCH_THRESHOLD=

# Upload limits
MAX_FILE_SIZE_MB=15
MAX_FILES_PER_UPLOAD=50

# Frontend URL (used for CORS + QR join links)
FRONTEND_URL=http://localhost:5173
